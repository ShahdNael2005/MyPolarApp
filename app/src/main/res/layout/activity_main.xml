<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <!-- Animated backdrop: radial gradient + wave field + hoops + particles + vignette -->
    <com.example.mypolarapp.HeartVisualizerView
        android:id="@+id/heartVisualizer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Heart image, pulses once per beat -->
    <ImageView
        android:id="@+id/heartImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.48"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/heart_pic"
        android:alpha="0.9"
        android:contentDescription="@string/heart_content_description" />

    <!-- BLE connection status from PolarLiveData -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#8EA6D8"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Left panel: heart rate readout -->
    <LinearLayout
        android:id="@+id/leftPanel"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_margin="28dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/PanelLabel"
            android:text="@string/label_heart_rate" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hrValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="72"
                android:textColor="#178DFF"
                android:textSize="52sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="10dp"
                android:text="@string/label_bpm"
                android:textColor="#9FB4DB"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/zoneStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/zone_normal"
            android:textColor="#13A8FF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Right panel: ECG waveform + legend -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_margin="28dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/PanelLabel"
            android:text="@string/label_ecg" />

        <com.example.mypolarapp.EcgWaveformView
            android:id="@+id/ecgWave"
            android:layout_width="match_parent"
            android:layout_height="90dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout style="@style/LegendRow">
                <View
                    style="@style/LegendDot"
                    android:backgroundTint="#FF2E52" />

                <TextView
                    style="@style/LegendLabel"
                    android:text="@string/legend_high" />
            </LinearLayout>

            <LinearLayout style="@style/LegendRow">
                <View
                    style="@style/LegendDot"
                    android:backgroundTint="#2AA8FF" />

                <TextView
                    style="@style/LegendLabel"
                    android:text="@string/legend_normal" />
            </LinearLayout>

            <LinearLayout style="@style/LegendRow">
                <View
                    style="@style/LegendDot"
                    android:backgroundTint="#21E6FF" />

                <TextView
                    style="@style/LegendLabel"
                    android:text="@string/legend_low" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom panel: controls -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_panel"
        android:orientation="horizontal"
        android:padding="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <Button
            android:id="@+id/soundButton"
            style="@style/HoloButton"
            android:text="@string/button_sound" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>